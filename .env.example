NODE_ENV=development
PORT=3000

# Use long, unique random values. Never commit the real .env file.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Server-only integrations. These values are never sent to visitors.
# Optional legacy fallback used only when a form has no saved per-form webhook.
GHL_WEBHOOK_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Firebase project/client metadata. Only FIREBASE_PROJECT_ID is needed by the server.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Server authentication: use these two values locally, or use
# GOOGLE_APPLICATION_CREDENTIALS / your hosting platform's Application Default Credentials.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_USE_ADC=false
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_SERVICES_COLLECTION=services
FIRESTORE_CATEGORIES_COLLECTION=categories
FIRESTORE_WEBHOOK_CONFIGS_COLLECTION=webhook_configs

# Comma-separated parent-page origins allowed to use the /embed route.
# Supports 'self', wildcard subdomains (e.g. https://*.domain.com), exact origins, and localhost ports.
# The main dashboard always remains same-origin only.
FRAME_ANCESTORS=self,http://localhost:*,http://127.0.0.1:*,https://bridgelandbuilders.com,https://*.bridgelandbuilders.com
